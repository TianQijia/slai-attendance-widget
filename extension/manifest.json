{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "SLAI 考勤小组件",
  "description": "每 30 分钟读取一次学校考勤，显示今日进度和当月每日时长。",
  "version": "1.4.2",
  "icons": {
    "16": "icons/slai-16.png",
    "32": "icons/slai-32.png",
    "48": "icons/slai-48.png",
    "64": "icons/slai-64.png",
    "128": "icons/slai-128.png",
    "256": "icons/slai-256.png"
  },
  "permissions": [
    "alarms",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://stu.slai.edu.cn/*",
    "https://sts.slai.edu.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/slai-16.png",
      "32": "icons/slai-32.png",
      "48": "icons/slai-48.png"
    },
    "default_title": "打开考勤小组件"
  }
}
